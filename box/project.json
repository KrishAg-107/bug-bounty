{
  "name": "loadtester",
  "description": "Load tester project that evaluates behaviour and whether expected load can be handled by the API/ website/ etc.",
  "github": "KrishAg-107/bug-bounty",
  "database": true,
  "ui": {
    "dev_callback_urls": [
      "http://localhost:5173/"
    ]
  },
  "services": [
    {
      "name": "js-api",
      "language": "node",
      "port": 3000,
      "memory_mib": 192,
      "prefix": "js_api",
      "routes": [
        {
          "method": "GET",
          "path": "/health",
          "signed_in": false
        },
        {
          "method": "GET",
          "path": "/hello",
          "signed_in": false
        },
        {
          "method": "POST",
          "path": "/echo",
          "signed_in": true
        },
        {
          "method": "GET",
          "path": "/openapi.json",
          "signed_in": false
        },
        {
          "method": "GET",
          "path": "/scalar-ui",
          "signed_in": false
        }
      ]
    },
    {
      "name": "py-api",
      "language": "python",
      "port": 8000,
      "memory_mib": 192,
      "prefix": "py_api",
      "routes": [
        {
          "method": "GET",
          "path": "/health",
          "signed_in": false
        },
        {
          "method": "GET",
          "path": "/hello",
          "signed_in": false
        },
        {
          "method": "POST",
          "path": "/echo",
          "signed_in": true
        },
        {
          "method": "GET",
          "path": "/openapi.json",
          "signed_in": false
        },
        {
          "method": "GET",
          "path": "/scalar-ui",
          "signed_in": false
        }
      ]
    }
  ]
}
